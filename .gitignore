# Large dataset files (GitHub blocks files > 100MB; SPARCS CSV is ~947MB)
dataset/*.csv
!dataset/.gitkeep
*.csv.zip
*.csv.gz

# Binaries and build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# SPIN / Promela generated files
/pan
/pan.*
/*.trail

# IDE / System
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Office temporary files
~$*.docx
~$*.pptx

# Perfiles de CPU (pprof) generados por `-mode=cpu-profile`: son
# binarios pesados y no reproducibles bit a bit entre corridas.
# El resto de la evidencia de results/ (benchmark/*.csv, *.md,
# resources/*.csv, environment.md) SÍ debe poder commitearse.
results/cpu/*.prof
